<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <!-- Materialize CSS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <!-- Material Icons -->
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  
  <style>
    /* Estilos temáticos de la Pokédex */
    .pokedex-frame {
      background-color: #dc0a2d;
      border-radius: 20px;
      padding: 25px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
      border: 4px solid #8b0000;
    }
    .pokedex-screen {
      background-color: #232323;
      border-radius: 12px;
      padding: 20px;
      border: 4px solid #dedede;
      color: #fff;
    }
    .pokedex-led-big {
      width: 42px;
      height: 42px;
      background: radial-gradient(circle at 30% 30%, #00f0ff, #006699);
      border-radius: 50%;
      border: 3px solid #fff;
      display: inline-block;
      box-shadow: 0 0 12px #00f0ff;
    }
    .pokedex-led-small {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      display: inline-block;
      margin-left: 8px;
      border: 1px solid #000;
    }
    .led-red { background: #ff0000; box-shadow: 0 0 6px #ff0000; }
    .led-yellow { background: #ffcc00; box-shadow: 0 0 6px #ffcc00; }
    .led-green { background: #00ff00; box-shadow: 0 0 6px #00ff00; }
    
    .pokedex-screen input, 
    .pokedex-screen label {
      color: #fff !important;
    }
    .pokedex-screen table th {
      color: #4fc3f7;
    }
  </style>
</head>
<body class="grey lighten-4">

  <!-- Navegación -->
  <nav class="blue darken-3">
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo"><i class="material-icons left">cloud</i>Express App</a>
      <ul id="nav-mobile" class="right hide-on-med-and-down">
        <li><a href="/">Inicio</a></li>
        <li><a href="/about">Acerca de</a></li>
        <li><a href="/contact">Contacto</a></li>
        <li><a href="/admin">Admin</a></li>
        <li class="active"><a href="/pokedex">Pokédex</a></li>
      </ul>
    </div>
  </nav>

  <!-- Contenedor Pokédex -->
  <div class="container" style="margin-top: 30px; margin-bottom: 50px;">
    
    <!-- Carcasa física Pokédex -->
    <div class="pokedex-frame">
      
      <!-- Luces superiores de la Pokédex -->
      <div style="display: flex; align-items: center; margin-bottom: 15px;">
        <div class="pokedex-led-big"></div>
        <div class="pokedex-led-small led-red"></div>
        <div class="pokedex-led-small led-yellow"></div>
        <div class="pokedex-led-small led-green"></div>
        <h5 class="white-text" style="margin: 0 0 0 20px; font-weight: bold; letter-spacing: 2px;">POKÉDEX V1.0</h5>
      </div>

      <!-- Pantalla 1: Formulario de Registro -->
      <div class="pokedex-screen">
        <h5 class="green-text text-accent-3" style="margin-top: 0; font-family: monospace;">
          <i class="material-icons left">add_circle</i>[ REGISTRAR NUEVO POKÉMON ]
        </h5>

        <form action="/pokedex" method="POST" style="margin-top: 20px;">
          <div class="row">
            <div class="input-field col s12 m6">
              <i class="material-icons prefix cyan-text">catching_pokemon</i>
              <input id="nombre" type="text" name="nombre" required class="white-text">
              <label for="nombre">Nombre del Pokémon</label>
            </div>
            <div class="input-field col s12 m6">
              <i class="material-icons prefix cyan-text">style</i>
              <input id="tipo" type="text" name="tipo" required class="white-text">
              <label for="tipo">Tipo (ej. Fuego, Agua)</label>
            </div>
          </div>

          <div class="row">
            <div class="input-field col s12 m4">
              <i class="material-icons prefix cyan-text">trending_up</i>
              <input id="nivel" type="number" name="nivel" required class="white-text">
              <label for="nivel">Nivel</label>
            </div>
            <div class="input-field col s12 m4">
              <i class="material-icons prefix cyan-text">favorite</i>
              <input id="hp" type="number" name="hp" required class="white-text">
              <label for="hp">Puntos de Vida (HP)</label>
            </div>
            <div class="input-field col s12 m4">
              <i class="material-icons prefix cyan-text">flash_on</i>
              <input id="habilidad" type="text" name="habilidad" required class="white-text">
              <label for="habilidad">Habilidad Especial</label>
            </div>
          </div>

          <div class="center-align" style="margin-top: 10px;">
            <button type="submit" class="btn-large waves-effect waves-light green accent-4 black-text" style="font-weight: bold; border-radius: 8px;">
              <i class="material-icons left">save</i>GUARDAR REGISTRO
            </button>
          </div>
        </form>
      </div>

      <!-- Pantalla 2: Base de Datos / Tabla -->
      <div class="pokedex-screen" style="margin-top: 20px;">
        <h5 class="cyan-text text-accent-2" style="margin-top: 0; font-family: monospace;">
          <i class="material-icons left">list_alt</i>[ BASE DE DATOS DE POKÉMON ]
        </h5>

        <% if (pokemons.length === 0) { %>
          <p class="yellow-text center-align" style="padding: 20px 0;">No hay Pokémon registrados aún.</p>
        <% } else { %>
          <div class="responsive-table">
            <table class="highlight">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Tipo</th>
                  <th>Nivel</th>
                  <th>HP</th>
                  <th>Habilidad</th>
                </tr>
              </thead>
              <tbody>
                <% pokemons.forEach(p => { %>
                  <tr>
                    <td style="font-weight: bold; color: #ffe082;">
                      <i class="material-icons tiny left red-text text-lighten-1">catching_pokemon</i><%= p.nombre %>
                    </td>
                    <td>
                      <span class="chip red darken-1 white-text" style="font-weight: 500;">
                        <%= p.tipo %>
                      </span>
                    </td>
                    <td class="cyan-text text-accent-1">Nv. <%= p.nivel %></td>
                    <td class="green-text text-accent-3"><%= p.hp %> HP</td>
                    <td class="grey-text text-lighten-1"><%= p.habilidad %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </div>

  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>