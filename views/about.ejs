<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <!-- Materialize CSS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <!-- Material Icons -->
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body class="grey lighten-4">

  <!-- Navegación -->
  <nav class="blue darken-3">
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo"><i class="material-icons left">cloud</i>Express App</a>
      <ul id="nav-mobile" class="right hide-on-med-and-down">
        <li><a href="/">Inicio</a></li>
        <li class="active"><a href="/about">Acerca de</a></li>
        <li><a href="/contact">Contacto</a></li>
        <li><a href="/admin">Admin</a></li>
        <li><a href="/pokedex">Pokédex</a></li>
      </ul>
    </div>
  </nav>

  <!-- Banner principal (Hero) -->
  <div class="blue darken-2 white-text center-align" style="padding: 50px 20px;">
    <div class="container">
      <h3 style="margin-top: 0;">Acerca del Proyecto</h3>
      <p class="flow-text">Aplicación web desarrollada para explorar la arquitectura MVC en Node.js y Express.</p>
    </div>
  </div>

  <!-- Tarjetas de Características y Tecnologías -->
  <div class="container" style="margin-top: 40px; margin-bottom: 40px;">
    <div class="row">

      <div class="col s12 m6 l3">
        <div class="card hoverable center-align">
          <div class="card-content">
            <i class="material-icons large blue-text">layers</i>
            <span class="card-title">Patrón MVC</span>
            <p>Organización en Rutas, Controladores y Vistas para mayor orden y escalabilidad.</p>
          </div>
        </div>
      </div>

      <div class="col s12 m6 l3">
        <div class="card hoverable center-align">
          <div class="card-content">
            <i class="material-icons large orange-text">code</i>
            <span class="card-title">Motor EJS</span>
            <p>Plantillas dinámicas para renderizar HTML con datos procesados desde el servidor.</p>
          </div>
        </div>
      </div>

      <div class="col s12 m6 l3">
        <div class="card hoverable center-align">
          <div class="card-content">
            <i class="material-icons large green-text">storage</i>
            <span class="card-title">Memoria</span>
            <p>Almacenamiento temporal de registros mediante estructuras de datos en JavaScript.</p>
          </div>
        </div>
      </div>

      <div class="col s12 m6 l3">
        <div class="card hoverable center-align">
          <div class="card-content">
            <i class="material-icons large teal-text">palette</i>
            <span class="card-title">Materialize</span>
            <p>Diseño basado en Material Design, completamente adaptable a dispositivos móviles.</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Tarjeta informativa de resumen -->
    <div class="row">
      <div class="col s12">
        <div class="card-panel white center-align">
          <h5><i class="material-icons teal-text" style="vertical-align: middle;">school</i> Laboratorio de Desarrollo Web</h5>
          <p class="flow-text" style="font-size: 1.1rem; margin-top: 15px;">
            Este proyecto demuestra el uso de peticiones HTTP (<strong>GET</strong> y <strong>POST</strong>), procesamiento de formularios, rutas dinámicas y manejo personalizado de errores HTTP 404.
          </p>
          <a href="/contact" class="btn waves-effect waves-light blue darken-2" style="margin-top: 10px;">
            <i class="material-icons left">send</i>Ir a Formulario de Contacto
          </a>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>