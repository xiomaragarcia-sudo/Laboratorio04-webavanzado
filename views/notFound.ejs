<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : '404 - No Encontrado' %></title>
  <!-- Materialize CSS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <!-- Material Icons -->
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body class="grey lighten-4">

  <!-- Navegación -->
  <nav class="blue darken-3">
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo"><i class="material-icons left">cloud</i>Express App</a>
      <ul id="nav-mobile" class="right hide-on-med-and-down">
        <li><a href="/">Inicio</a></li>
        <li><a href="/about">Acerca de</a></li>
        <li><a href="/contact">Contacto</a></li>
        <li><a href="/admin">Admin</a></li>
        <li><a href="/pokedex">Pokédex</a></li>
      </ul>
    </div>
  </nav>

  <!-- Contenido Principal 404 -->
  <div class="container" style="margin-top: 60px; margin-bottom: 60px;">
    <div class="row">
      <div class="col s12 m8 offset-m2 l6 offset-l3">
        <div class="card-panel white center-align z-depth-1" style="border-radius: 8px; padding: 40px 20px;">
          
          <i class="material-icons large red-text text-darken-1">error_outline</i>
          
          <h4 style="margin-top: 15px; font-weight: 500;" class="grey-text text-darken-3">
            404 - Página No Encontrada
          </h4>
          
          <p class="flow-text grey-text text-darken-1" style="font-size: 1.1rem; margin-top: 15px;">
            La ruta <code class="red lighten-5 red-text text-darken-2" style="padding: 4px 8px; border-radius: 4px;"><%= url %></code> no existe en este servidor.
          </p>

          <div style="margin-top: 30px;">
            <a href="/" class="btn-large waves-effect waves-light blue darken-3">
              <i class="material-icons left">home</i>Volver al Inicio
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>